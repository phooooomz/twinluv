rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // โปรไฟล์ส่วนตัว: อ่าน/เขียนได้เฉพาะเจ้าของ
    match /artifacts/{appId}/users/{uid}/profile/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ห้อง: ต้องรู้รหัส 6 หลักถึงจะ get ได้ (ห้าม list)
    match /artifacts/{appId}/public/data/rooms/{code} {
      allow get: if request.auth != null;
      allow list: if false;

      allow create: if request.auth != null
        && request.resource.data.memberIds == [request.auth.uid];

      // สมาชิกแก้ไขได้ (เหรียญ, สัตว์เลี้ยง ฯลฯ) แต่เปลี่ยนรายชื่อสมาชิกไม่ได้
      allow update: if request.auth != null
        && request.auth.uid in resource.data.memberIds
        && request.resource.data.memberIds == resource.data.memberIds;

      // คนที่ 2 เข้าห้อง: ห้องมีแค่ 1 คน และแก้ได้เฉพาะ members/memberIds
      allow update: if request.auth != null
        && !(request.auth.uid in resource.data.memberIds)
        && resource.data.memberIds.size() == 1
        && request.resource.data.memberIds.size() == 2
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberIds']);

      allow delete: if false;
    }

    // ข้อมูลของห้อง (room_CODE_daily / someday / quizzes / activities)
    // เข้าถึงได้เฉพาะสมาชิกของห้องนั้น
    match /artifacts/{appId}/public/data/{col}/{docId} {
      allow read, write: if request.auth != null
        && col.matches('room_[A-Z0-9]{6}_.*')
        && exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/rooms/$(col.split('_')[1]))
        && request.auth.uid in get(/databases/$(database)/documents/artifacts/$(appId)/public/data/rooms/$(col.split('_')[1])).data.memberIds;
    }
  }
}
